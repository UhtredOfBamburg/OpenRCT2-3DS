set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR armv6k)
set(NINTENDO_3DS TRUE CACHE BOOL "Nintendo 3DS target")

if(NOT DEFINED DEVKITPRO)
    if(DEFINED ENV{DEVKITPRO})
        set(DEVKITPRO "$ENV{DEVKITPRO}")
    elseif(EXISTS "/Users/pdrtorres/.gemini/antigravity/scratch/tools/dkp_root/opt/devkitpro")
        set(DEVKITPRO "/Users/pdrtorres/.gemini/antigravity/scratch/tools/dkp_root/opt/devkitpro")
    else()
        set(DEVKITPRO "/opt/devkitpro")
    endif()
endif()
set(DEVKITARM "${DEVKITPRO}/devkitARM")
set(ENV{DEVKITPRO} "${DEVKITPRO}")
set(ENV{DEVKITARM} "${DEVKITARM}")

set(CMAKE_C_COMPILER "${DEVKITARM}/bin/arm-none-eabi-gcc")
set(CMAKE_CXX_COMPILER "${DEVKITARM}/bin/arm-none-eabi-g++")
set(CMAKE_AR "${DEVKITARM}/bin/arm-none-eabi-gcc-ar" CACHE FILEPATH "Archiver")
set(CMAKE_RANLIB "${DEVKITARM}/bin/arm-none-eabi-gcc-ranlib" CACHE FILEPATH "Ranlib")

set(ARCH_FLAGS "-march=armv6k -mtune=mpcore -mfloat-abi=hard -mtp=soft")
set(CMAKE_C_FLAGS_INIT "${ARCH_FLAGS} -ffunction-sections -fdata-sections -D__3DS__ -D_3DS")
set(CMAKE_CXX_FLAGS_INIT "${ARCH_FLAGS} -ffunction-sections -fdata-sections -D__3DS__ -D_3DS")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${ARCH_FLAGS} -specs=3dsx.specs -Wl,--gc-sections")

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(CMAKE_FIND_ROOT_PATH "${DEVKITARM}/arm-none-eabi" "${DEVKITPRO}/libctru" "${DEVKITPRO}/portlibs/3ds")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
